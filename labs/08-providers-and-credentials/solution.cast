[5.780452, "o", "# Training provider profile. It declares one bearer credential and the only\r\n# endpoint where OpenShell may resolve it: httpbin.org, which echoes request\r\n# headers back so you can watch the real value appear on the wire.\r\n"]
[5.780465, "o", "id: echo-api"]
[5.780732, "o", "\r\ndisplay_name: Echo API (training)\r\ndescription: Training profile that binds DEMO_API_TOKEN to httpbin.org only\r\ncategory: other\r\n\r\ncredentials:\r\n  - name: api_token\r\n    description: Demo bearer token\r\n    env_vars: [DEMO_API_TOKEN]\r\n    required: true\r\n    auth_style: bearer\r\n    header_name: authorization\r\n\r\nendpoints:\r\n  - host: httpbin.org\r\n    port: 443\r\n    protocol: rest\r\n    enforcement: enforce\r\n    access: read-only\r\n\r\nbinaries:\r\n  - /usr/bin/curl\r\n"]
