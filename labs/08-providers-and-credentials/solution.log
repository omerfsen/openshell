[36m# Lab 08 — Providers: credentials the agent never sees[0m
[32m$ [0m[1mopenshell sandbox delete cred; openshell provider delete echo; openshell profile delete echo-api[0m
[32m$ [0m[1mcat labs/08-providers-and-credentials/echo-api.yaml[0m
# Training provider profile. It declares one bearer credential and the only
# endpoint where OpenShell may resolve it: httpbin.org, which echoes request
# headers back so you can watch the real value appear on the wire.
id: echo-api
display_name: Echo API (training)
description: Training profile that binds DEMO_API_TOKEN to httpbin.org only
category: other

credentials:
  - name: api_token
    description: Demo bearer token
    env_vars: [DEMO_API_TOKEN]
    required: true
    auth_style: bearer
    header_name: authorization

endpoints:
  - host: httpbin.org
    port: 443
    protocol: rest
    enforcement: enforce
    access: read-only

binaries:
  - /usr/bin/curl
