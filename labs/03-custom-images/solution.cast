[43.907193, "o", "# only when the sandbox has no saved policy (no --policy, no global policy).\r\nversion: 1\r\nfilesystem_policy:\r\n  include_workdir: true\r\n  read_only: [/usr, /lib, /etc, /proc, /dev/urandom]\r\n  read_write: [/tmp, /dev/null]\r\nlandlock:\r\n  compatibility: best_effort\r\nnetwork_policies:\r\n  echo_get:\r\n    endpoints:\r\n      - host: postman-echo.com\r\n        port: 443\r\n        protocol: rest\r\n        enforcement: enforce\r\n        rules:\r\n          - allow:\r\n              method: GET\r\n              path: /get\r\n    binaries:\r\n      - path: /usr/bin/curl\r\n"]
