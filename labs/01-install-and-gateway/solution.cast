[27.315664, "o", "# Example gateway configuration for the local Debian/Ubuntu gateway.\r\n"]
[27.315683, "o", "# Copy to ~/.config/openshell/gateway.toml, preflight, then restart the\r\n# openshell-gateway user service. Omit the file to keep built-in defaults.\r\n[openshell]\r\nversion = 2"]
[27.315693, "o", "\r\n"]
[27.315704, "o", "\r\n"]
[27.315714, "o", "[openshell.gateway]\r\n"]
[27.315788, "o", "bind_address   = \"127.0.0.1:17670\"\r\nlog_level      = \"info\"\r\n"]
[27.315797, "o", "compute_driver = \"docker\"\r\n\r\n[openshell.drivers.docker]\r\n"]
[27.315805, "o", "socket_path        = \"/var/run/docker.sock\""]
[27.315813, "o", "\r\n"]
[27.315821, "o", "# Sandboxes created without --from use the training tools image."]
[27.31583, "o", "\r\n"]
[27.315838, "o", "default_image      = \"openshell-training/tools:0.1.4\""]
[27.31587, "o", "\r\nimage_pull_policy  = \"if_not_present\"\r\n"]
[27.315879, "o", "sandbox_pids_limit = 1024"]
[27.315908, "o", "\r\n"]
