[14.527125, "o", "\u001b[36;1mGateway Info\u001b[0m\r\n\r\n  \u001b[2mGateway:\u001b[0m openshell\r\n  \u001b[2mServer:\u001b[0m https://127.0.0.1:17670\r\n  \u001b[2mStatus:\u001b[0m healthy\r\n  \u001b[2mVersion:\u001b[0m 0.1.4\r\n  \u001b[2mCompute drivers:\u001b[0m\r\n    docker\r\n      \u001b[2mDriver version:\u001b[0m 0.1.4\r\n  \u001b[2mExtensions:\u001b[0m\r\n    docker (compute-driver)\r\n      \u001b[2mImplementation:\u001b[0m openshell/docker 0.1.4 (protocol 1.0)\r\n      \u001b[2mCapabilities:\u001b[0m openshell.compute.contract\r\n      \u001b[2mRequires gateway:\u001b[0m openshell.compute.contract\r\n    openshell-driver-db-credstore (credential-driver)\r\n      \u001b[2mImplementation:\u001b[0m openshell/openshell-driver-db-credstore 0.1.4 (protocol 1.0)\r\n      \u001b[2mCapabilities:\u001b[0m openshell.credentials.contract\r\n      \u001b[2mRequires gateway:\u001b[0m openshell.credentials.contract\r\n    openshell/regex (supervisor-middleware)\r\n      \u001b[2mImplementation:\u001b[0m openshell/regex 0.1.4 (protocol 1.0)\r\n      \u001b[2mCapabilities:\u001b[0m openshell.supervisor-middleware.contract\r\n      \u001b[2mRequires gateway:\u001b[0m openshell.supervisor-middleware.contract\r\n"]
