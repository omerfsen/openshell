[6.413779, "o", "# OpenRouter provider profile for the training, adapted from NVIDIA's example\r\n"]
[6.413942, "o", "# (providers/openrouter.yaml at v0.1.4). Changes: a separate id, and curl added\r\n# to `binaries` so you can test the credential path before running an agent.\r\n#\r\n# Credential scope: OPENROUTER_API_KEY, sent as a bearer token to openrouter.ai\r\n# and nowhere else.\r\nid: openrouter-training\r\ndisplay_name: OpenRouter (training)\r\ndescription: OpenRouter inference API for OpenCode and curl"]
[6.414055, "o", "\r\ncategory: inference\r\ninference_capable: true\r\ncredentials:\r\n  - name: api_key\r\n    description: OpenRouter API key\r\n"]
[6.414167, "o", "    env_vars: [OPENROUTER_API_KEY]\r\n    required: true\r\n    auth_style: bearer\r\n    header_name: authorization"]
[6.414245, "o", "\r\ndiscovery:\r\n  credentials: [api_key]\r\nendpoints:\r\n"]
[6.414313, "o", "  - host: openrouter.ai\r\n    port: 443\r\n    protocol: rest\r\n"]
[6.414381, "o", "    access: read-write\r\n    enforcement: enforce\r\nbinaries:\r\n"]
[6.414676, "o", "  - /usr/local/bin/opencode\r\n  - /usr/bin/curl\r\n"]
[7.920169, "o", "\u001b[32m$ \u001b[0m\u001b[1m"]
