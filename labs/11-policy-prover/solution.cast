[19.634454, "o", "# The most access any training sandbox may ever have. Candidate policies are\r\n# proven against this file with openshell-prover; anything beyond it fails CI.\r\nversion: 1\r\nfilesystem_policy:\r\n  include_workdir: true\r\n  read_only: [/bin, /usr, /lib, /proc, /dev/urandom, /etc, /var/log]\r\n  read_write: [/tmp, /dev/null]\r\nlandlock:\r\n  compatibility: best_effort\r\nnetwork_policies:\r\n  echo_read:\r\n    endpoints:\r\n      - host: postman-echo.com\r\n        port: 443\r\n        protocol: rest\r\n        enforcement: enforce\r\n        access: read-only\r\n    binaries:\r\n      - path: /usr/bin/curl\r\n"]
