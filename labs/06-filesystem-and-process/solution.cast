[2.095668, "o", "\u001b[0m\r\n"]
[3.602958, "o", "# A policy file applied at sandbox creation. The filesystem and process\r\n# sections are locked once the sandbox starts; network rules can change later.\r\nversion: 1\r\n\r\nfilesystem_policy:"]
[3.603376, "o", "\r\n  include_workdir: true        # the working directory (/home/ubuntu) is read-write\r\n  read_only:\r\n    - /usr\r\n    - /lib\r\n    - /etc\r\n    - /proc\r\n    - /dev/urandom\r\n  read_write:\r\n    - /tmp\r\n    - /dev/null\r\n\r\nlandlock:\r\n  compatibility: hard_requirement   # refuse to start if Landlock cannot be applied\r\n\r\nprocess:\r\n  run_as_user: \"1000\"\r\n  run_as_group: \"1000\"\r\n\r\nnetwork_policies: {}\r\n"]
